// prisma/schema.prisma
// PostgreSQL: ogni riga "Tenant" è un'attività cliente (ristorante, studio, ecc.)
// Un solo server gestisce tutti i tenant, distinguendoli per numero Twilio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String   @id @default(cuid())
  businessName          String
  businessType          String   // "ristorante" | "studio_dentistico" | "studio_medico" | ecc.
  twilioPhoneNumber     String   @unique   // numero su cui riceve le chiamate questo cliente
  timezone              String   @default("Europe/Rome")
  openingHours          String
  address               String
  maxPartySizeNoHuman   Int?     // oltre questa soglia, trasferisci a operatore umano
  humanOperatorNumber   String?
  durataAppuntamentoMin Int      @default(60) // durata slot: 60 per medico/dentista, 120 per ristorante ecc.
  capienzaTotale        Int?     // solo per ristoranti: posti totali

  // Collegamento Google Calendar del CLIENTE (non tuo!), via OAuth
  googleCalendarId       String?
  googleRefreshTokenEnc  String? // refresh token cifrato, mai in chiaro

  // Stato commerciale
  active    Boolean  @default(true)
  plan      String   @default("trial") // "trial" | "base" | "pro"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([twilioPhoneNumber])
}
