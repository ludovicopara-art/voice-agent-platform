# --- Database ---
# Postgres gestito (Supabase, Railway, Neon...). Esempio formato:
DATABASE_URL="postgresql://utente:password@host:5432/nomedb"

# --- Cifratura token OAuth ---
# Genera UNA VOLTA con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Conservala solo come variabile d'ambiente del server, mai nel codice.
ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Chiave per proteggere le rotte /admin/* (da sostituire con auth vera) ---
ADMIN_API_KEY=cambia-questa-chiave-lunga-e-casuale

# --- Twilio (account TUO, che possiede i numeri assegnati ai clienti) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OAuth Google (creato UNA VOLTA nel TUO progetto Google Cloud;
#     ogni cliente lo userà per autorizzare l'accesso al SUO calendario) ---
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Server ---
PORT=3000
BASE_URL=https://tua-piattaforma.it
